IMG="$1"
CACHE_DIR="$HOME/.cache/wal"
CANONICAL_WAL="$CACHE_DIR/current_wallpaper"

if [ -z "$IMG" ] || [ ! -f "$IMG" ]; then
  echo "Usage: setwall /path/to/image"
  exit 1
fi

awww img "$IMG" --transition-type any --transition-step 10 &

wal -q -i "$IMG" 

cp "$IMG" "$CANONICAL_WAL"
# now we can add commands that reload / change theme of all our apps :)

#kill and reload waybar
pkill waybar 2>/dev/null
waybar &
